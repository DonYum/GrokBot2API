HOST=127.0.0.1
PORT=8793
GROKBOT2API_KEY=change-me
GROKBOT_MODEL=grok-4.5
GROKBOT_UPSTREAM_MODEL=grok-4.5
GROKBOT_CLIENT_VERSION=0.27.0

# Request JSON body cap in bytes. Default: 1048576 (1 MiB). Hard max: 16777216.
# Increase explicitly for Grok CLI/agent requests with large tool schemas.
# GROKBOT_MAX_BODY_BYTES=8388608

# Linux/manual bootstrap path. Prefer short-lived files owned by the service user.
# The sidecar reads credentials on every request and never writes this file.
# {
#   "accessToken": "eyJ...",
#   "machineId": "...",
#   "clientVersion": "0.27.0"
# }
# GROKBOT_CREDENTIALS_FILE=/run/grokbot2api/credentials.json

# Linux refresh path. The command must be an absolute path and must print only:
# {"accessToken":"eyJ...","machineId":"...","clientVersion":"0.27.0"}
# It runs without a shell on every request, so an external Grok Bot/runtime helper
# can refresh credentials without this service storing tokens.
# GROKBOT_CREDENTIALS_COMMAND=/usr/local/lib/grokbot2api/credentials-helper.mjs
# GROKBOT_CREDENTIALS_COMMAND_TIMEOUT_MS=5000

# Direct env fallback for isolated tests only.
# GROKBOT_ACCESS_TOKEN=
# GROKBOT_MACHINE_ID=

# Non-loopback bind is blocked unless this is explicit.
# GROKBOT_ALLOW_PRIVATE_BIND=1
